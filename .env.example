# BharatCode API Configuration
# Get your key at: https://bharatcode.ai/account
BHARATCODE_API_KEY=your_api_key_here

# BharatCode Endpoint & Model
BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1
BHARATCODE_MODEL=qwen-3.8-27b

# Context Budget & Compaction Threshold
CTXBEACON_CONTEXT_BUDGET_TOKENS=4096
CTXBEACON_COMPACTION_THRESHOLD=0.75
CTXBEACON_KEEP_RECENT_TURNS=3
CTXBEACON_MAX_TURNS=10
